    maxProducts: -1,
    maxCategories: -1,
    maxTables: -1,
    allowsOnlinePay: true,
    allowsAnalytics: true,
    allowsCustomDomain: true,
    sortOrder: 2,
  },
];

interface SeedProduct {
  name: string;
  nameEn: string;
  short: string;
  full: string;
  price: number;
  cost: number;
  prep?: number;
  featured?: boolean;
  info: { title: string; content: string; icon: string }[];
}

interface SeedCategory {
  name: string;
  nameEn: string;
  icon: string;
  products: SeedProduct[];
}

