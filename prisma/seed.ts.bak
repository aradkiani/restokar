  await seedRestaurant({
    slug: "demo-noir",
    name: "رستوران نوآر",
    nameEn: "Noir",
    tagline: "فاین‌دایینگ، منوی فصلی",
    description: "نمونه‌ی قالب نوآر — تیره، مینیمال و مناسب رستوران‌های لوکس.",
    ownerName: "نمونه نوآر",
    ownerEmail: "demo@demo-noir.menuland.ir",
    templateId: "noir",
    theme: {
      primary: "#a16207",
      secondary: "#57534e",
      background: "#0c0a09",
      surface: "#1c1917",
      text: "#fafaf9",
      muted: "#a8a29e",
    },
    planCode: "enterprise",
    onlinePayment: true,
    menu: FINE_DINING_MENU,
    tableCount: 12,
    isDemo: true,
    skipOrders: true,
  });
}

main()
  .catch((error) => {
    console.error(error);
    process.exit(1);
  })
  .finally(() => prisma.$disconnect());
