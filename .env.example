# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml; host port 5433 avoids clashing with a
# local Postgres already listening on 5432)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://restokar:restokar@localhost:5433/restokar?schema=public"

# ---------------------------------------------------------------------------
# Auth — MUST be replaced in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to boot in production with the value below.
# ---------------------------------------------------------------------------
AUTH_SECRET="dev-only-insecure-secret-change-me-before-deploying-anywhere"

# Public origin, used for QR codes, payment callbacks and canonical SEO URLs.
# Production must be a real https:// domain — the app refuses to boot otherwise,
# because this value is baked into printed QR codes.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Feature switches
#
# Both default to OFF. Only "true" or "1" enable them; anything ambiguous is
# treated as off, which for a payment switch is the safe answer.
# ---------------------------------------------------------------------------
# A guest paying a restaurant for their order. With PAYMENT_PROVIDER="mock"
# below this is a simulation: the full redirect and callback run, the order is
# confirmed, and no network call or money movement happens. Safe to switch on
# for a demo; needs a real ZARINPAL_MERCHANT_ID before it means anything.
# ENABLE_PAYMENTS="true"
#
# A venue paying *us* for its subscription. Deliberately a separate switch from
# the one above: demonstrating a guest checkout must not also let a venue
# "renew" against a mock provider and be recorded as paid.
# ENABLE_SUBSCRIPTION_CHECKOUT="true"
#
# A venue paying *us* for a promotional SMS. Separate again, and for a sharper
# reason: a paid request lands in the admin queue, and staff sending it pay the
# SMS line out of pocket. Against the mock gateway it would be "paid" by nobody.
# Leave off until a real ZARINPAL_MERCHANT_ID exists.
# ENABLE_SMS_CHECKOUT="true"
#
# ENABLE_PUBLIC_REGISTRATION="true"

# ---------------------------------------------------------------------------
# Payments — Zarinpal (https://www.zarinpal.com)
# PROVIDER: "zarinpal" | "mock"
# "mock" simulates the full redirect + callback flow with no network calls.
# ---------------------------------------------------------------------------
PAYMENT_PROVIDER="mock"
ZARINPAL_MERCHANT_ID=""
# Set to "true" to use Zarinpal's sandbox endpoints instead of production.
ZARINPAL_SANDBOX="true"

# ---------------------------------------------------------------------------
# Storage — "local" writes to $DATA_DIR/uploads.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"

# ---------------------------------------------------------------------------
# Customer data directory
#
# Uploads, backups and job logs. Deliberately OUTSIDE the application tree so
# the core project can be regenerated or redeployed without touching anything a
# customer created. See docs/DATA-BOUNDARY.md.
#
# Relative paths resolve from this directory (the application root), so the
# default points at the sibling `data/` folder one level up — outside everything
# a redeploy replaces.
#
# Production should use an absolute path on its own volume, e.g.
#   DATA_DIR="/var/lib/restokar"
# ---------------------------------------------------------------------------
DATA_DIR="../data"

# ---------------------------------------------------------------------------
# Proxy
#
# How many proxies of our own sit in front of the app — 1 for the documented
# single-nginx deployment. Used to pick the trustworthy entry out of
# x-forwarded-for; setting it too high lets a client choose the address the
# rate limiter counts against.
# ---------------------------------------------------------------------------
TRUSTED_PROXY_HOPS="1"

# ---------------------------------------------------------------------------
# Backup email (SMTP)
#
# Plain SMTP: free with any mailbox you already own, no API key, no vendor
# account. Leave SMTP_HOST empty to disable email delivery — backups are still
# written to $DATA_DIR/backups.
#
# The DESTINATION address is NOT here. It is set in the admin console at
# /admin/settings so it can change without a redeploy. See docs/BACKUPS.md.
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Demo seed (development only)
#
# The seeds in prisma/ create sample restaurants, months of invented orders and
# accounts with a known password. They refuse to run unless BOTH of the
# following are true and DATABASE_URL points at localhost. Never set these on a
# server. See docs/RUNBOOK.md.
# ---------------------------------------------------------------------------
# Must be exactly "true" to let any demo seed run. Empty means refuse.
ALLOW_DEMO_SEED=""
# Password given to every seeded account. Empty means one is generated per run
# and printed once, so no working password is ever committed.
DEMO_SEED_PASSWORD=""

# How old the newest backup archive may be before /api/health reports degraded
# (HTTP 503), in hours. The schedule runs twice a day, so the default of 48 is
# two missed runs. "No backup at all" is always degraded.
BACKUP_MAX_AGE_HOURS="48"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
# "true" for implicit TLS on port 465. When false, STARTTLS is required.
SMTP_SECURE="false"

# ---------------------------------------------------------------------------
# SMS — Melipayamak (https://www.melipayamak.com), for ONE-TIME CODES ONLY
#
# The API sends approved pattern messages (OTP) and nothing else. Promotional
# messages never go through it — see "Promotional SMS" below.
#
# Both defaults spend nothing. Sending for real takes two deliberate changes:
# SMS_PROVIDER=melipayamak AND SMS_DRY_RUN=false.
#
# Reached over SOAP with plain fetch, not the `melipayamak-api` npm package: it
# cannot send pattern messages, hardcodes http:// so the password travels in
# clear text, and brings seven critical advisories. See src/lib/sms/melipayamak.ts.
# ---------------------------------------------------------------------------
# "melipayamak" | "mock". Mock logs instead of sending.
SMS_PROVIDER="mock"

# Log every send instead of performing it. Defaults to "true" EVERYWHERE,
# including production. Set to "false" only when you mean it.
SMS_DRY_RUN="true"

MELIPAYAMAK_USERNAME=""
# The account's API key (Melipayamak panel), NOT the login password. An account
# that requires a key answers the login password with -110 ("must authenticate
# with an API key rather than a password"). Keeping the key here also means the
# login password is never stored on the server.
MELIPAYAMAK_PASSWORD=""

# The approved OTP pattern id (bodyId), issued by Melipayamak once the template
# is reviewed. 0 means "not set up" and codes are skipped. The suggested text
# and variable order are in src/lib/sms/patterns.ts. A pattern carries its own
# sender line, so there is no sender-number setting.
SMS_PATTERN_OTP="0"

# One-time code limits. They exist to stop someone draining prepaid credit:
# every request for a code sends a billed message.
OTP_CODE_LENGTH="5"
OTP_TTL_SECONDS="120"
OTP_RESEND_COOLDOWN_SECONDS="60"
OTP_MAX_ATTEMPTS="5"

# ---------------------------------------------------------------------------
# Promotional SMS — paid by the venue, sent by platform staff
#
# A venue writes a message for a campaign or a customer group and pays for it.
# The paid request appears in the admin console (/admin/sms) with a download of
# the recipients' numbers; staff send it with a separate tool and mark it sent.
# Nothing in the application sends it.
#
# Paying is switched on with ENABLE_SMS_CHECKOUT (see "Feature switches").
# ---------------------------------------------------------------------------
# Whole Toman per SMS part per recipient. Persian is 70 characters for one part
# and 67 per part after that, so a longer message costs a multiple of this.
# A placeholder until the real price is set.
SMS_PRICE_PER_PART="200"

# Appended to every promotional text. Without it an SMS line refuses a
# multi-recipient send (code 15). Latin digits on purpose — the line matches
# literally, and "لغو۱۱" with Persian digits is a different string.
SMS_OPT_OUT_SUFFIX="لغو11"
